# Copy to .env and fill in. NEVER commit a real .env.
# Required for live mode (omit when using MOCK_LLM=1):
LLM_API_KEY=your-key-here
# Optional overrides (OpenAI-compatible endpoints: OpenAI, Azure, Ollama, LM Studio):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Offline development without any API key:
# MOCK_LLM=1
# Optional server settings:
# PORT=8000
# PROFILE_PATH=data/profile.json
